{"version":3,"term":{"cols":120,"rows":35},"timestamp":1789478151,"idle_time_limit":3.0,"command":"python3 docs/tools/record_readme_examples.py --session trade-quote-asof","env":{"SHELL":"/bin/zsh"}}
[0.134, "o", "\u001b[2J\u001b[H\u001b[36mDOGPADDLE · 成交匹配当时最近的报价\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n-- Match every fill with the latest quote visible at execution time.\r\nINSERT INTO postgres(\r\n    connection => env('DOGPADDLE_EXECUTION_QUALITY_TARGET'),\r\n    table => 'analytics.execution_quality'\r\n)\r\nSELECT\r\n    fills.trade_id,\r\n    fills.symbol,\r\n    fills.executed_at,\r\n    fills.side,\r\n    fills.price_cents AS execution_price_cents,\r\n    quotes.quoted_at,\r\n    (quotes.bid_cents + quotes.ask_cents) / 2 AS arrival_mid_cents,\r\n    CASE\r\n        WHEN fills.side = 'BUY' THEN fills.price_cents - (quotes.bid_cents + quotes.ask_cents) / 2\r\n        ELSE (quotes.bid_cents + quotes.ask_cents) / 2 - fi"]
[0.002, "o", "lls.price_cents\r\n    END AS slippage_cents\r\nFROM postgres_cdc(\r\n    connection => env('DOGPADDLE_FILLS_SOURCE'),\r\n    table => 'market.fills',\r\n    publication => 'dogpaddle_fills'\r\n) AS fills\r\nASOF JOIN postgres_cdc(\r\n    connection => env('DOGPADDLE_QUOTES_SOURCE'),\r\n    table => 'market.quotes',\r\n    publication => 'dogpaddle_quotes'\r\n) AS quotes\r\nMATCH_CONDITION (fills.executed_at >= quotes.quoted_at)\r\nON fills.symbol = quotes.symbol;\r\n\r\n"]
[2.500, "o", "\u001b[36m$\u001b[0m dogpaddle run pipeline.sql --state ./state >dogpaddle.log 2>&1 &\r\n"]
[19.756, "o", "\u001b[2J\u001b[H\u001b[36mDOGPADDLE · 历史报价改变后，已有成交重新匹配\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m$\u001b[0m psql -X -v ON_ERROR_STOP=1 -f examples/trade-quote-asof/steps/01-backfill-closer-quote.sql\r\n"]
[0.068, "o", "INSERT 0 1\r\n"]
[0.315, "o", "\r\n\u001b[33mSOURCE\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m$\u001b[0m psql -X -v ON_ERROR_STOP=1 -c 'SELECT quote_id AS id, to_char(quoted_at, '\"'\"'HH24:MI:SS.MS'\"'\"') AS quoted_at, bid_cents AS bid, ask_cents AS ask FROM market.quotes ORDER BY quote_id'\r\n"]
[0.075, "o", "id |  quoted_at   |  bid  |  ask  \r\n----+--------------+-------+-------\r\n  1 | 09:30:00.100 | 10000 | 10020\r\n  2 | 09:30:00.400 | 10008 | 10016\r\n(2 rows)\r\n\u001b[32mRESULT\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m$\u001b[0m psql -X -v ON_ERROR_STOP=1 -c 'SELECT result.trade_id AS trade, to_char(quote.quoted_at, '\"'\"'HH24:MI:SS.MS'\"'\"') AS matched_quote, result.arrival_mid_cents AS mid, result.slippage_cents AS slip FROM analytics.execution_quality AS result JOIN market.quotes AS quote ON result.quoted_at = (extract(epoch FROM quote.quoted_at) * 1000000)::bigint'\r\n"]
