{"version":3,"term":{"cols":120,"rows":35},"timestamp":1789478184,"idle_time_limit":3.0,"command":"python3 docs/tools/record_readme_examples.py --session store-sales-summary","env":{"SHELL":"/bin/zsh"}}
[0.244, "o", "\u001b[2J\u001b[H\u001b[36mDOGPADDLE · 退款发生后修正门店销售汇总\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n-- Maintain one current sales summary for every store.\r\nINSERT INTO postgres(\r\n    connection => env('DOGPADDLE_STORE_SALES_TARGET'),\r\n    table => 'analytics.store_sales'\r\n)\r\nSELECT\r\n    store_id,\r\n    COUNT(*) AS order_count,\r\n    SUM(amount_cents) AS revenue_cents,\r\n    AVG(amount_cents) AS average_order_cents,\r\n    MIN(amount_cents) AS smallest_order_cents,\r\n    MAX(amount_cents) AS largest_order_cents\r\nFROM postgres_cdc(\r\n    connection => env('DOGPADDLE_STORE_SALES_SOURCE'),\r\n    table => 'sales.store_orders',\r\n    publication => 'dogpaddle_store_sales'\r\n)\r\nWHERE status = 'paid'\r\nGR"]
[0.000, "o", "OUP BY store_id;\r\n\r\n"]
[2.502, "o", "\u001b[36m$\u001b[0m dogpaddle run pipeline.sql --state ./state >dogpaddle.log 2>&1 &\r\n"]
[6.036, "o", "\u001b[2J\u001b[H\u001b[36mDOGPADDLE · 付款、改价和退款持续改变分组结果\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m$\u001b[0m psql -X -v ON_ERROR_STOP=1 -f examples/store-sales-summary/steps/01-pay-order.sql\r\n"]
[0.068, "o", "UPDATE 1\r\n"]
