  "offset.flush.interval.ms": "500",
  "offset.flush.timeout.ms": "5000",
  "lsn.flush.mode": "connector",
  "heartbeat.interval.ms": "0",
  "poll.interval.ms": "100",
  "max.batch.size": "64",
  "max.queue.size": "256",
  "tombstones.on.delete": "false",
  "provide.transaction.metadata": "false"
