{
  "name": "dogpaddle-debezium-d1",
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "database.hostname": "127.0.0.1",
  "database.port": "55432",
  "database.dbname": "dogpaddle_d1",
  "database.user": "dogpaddle_d1",
  "database.password": "dogpaddle_d1",
  "topic.prefix": "dogpaddle_d1",
  "plugin.name": "pgoutput",
  "slot.name": "dogpaddle_d1_slot",
  "slot.drop.on.stop": "false",
